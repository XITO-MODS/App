<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/join_popup_bg"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginBottom="14dp"
        android:src="@drawable/ic_xito_logo"
        android:scaleType="fitCenter"
        android:contentDescription="Logo XITO MODS" />

    <TextView
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FF00F5D4"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="XITO MODS V4 NEON"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.06" />

    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFBC13FE"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="CANAL OFICIAL XITO MODS" />

    <TextView
        android:textSize="13sp"
        android:textColor="#FF9BA6C4"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="22dp"
        android:text="Bienvenido a XITO MODS. Accede al canal oficial para ver nuevas actualizaciones, configuraciones y claves activas." />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/btn_popup_dismiss"
            android:textSize="13sp"
            android:textColor="#FF9BA6C4"
            android:background="@drawable/btn_neon_secondary"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginRight="8dp"
            android:text="AHORA NO"
            android:layout_weight="1"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_popup_join"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FF080A10"
            android:background="@drawable/btn_neon_primary"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginLeft="8dp"
            android:text="ABRIR CANAL"
            android:layout_weight="1"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
