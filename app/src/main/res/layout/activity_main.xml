<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05140C"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Encabezado Proyecto RGB Dual + Estado de Licencia -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0C2618"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="XITO RGB SHIZUKU PANEL"
                android:textColor="#00E676"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLicenseBadge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Licencia Activa: Verificando..."
                android:textColor="#69F0AE"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvShizukuStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#123824"
                android:padding="10dp"
                android:text="Estado de Shizuku: Verificando..."
                android:textColor="#FFD166"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRequestShizuku"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#00C853"
                android:text="Conectar / Autorizar Shizuku"
                android:textAllCaps="false"
                android:textColor="#041009"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnLogoutKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="#1B4D32"
                android:text="Cambiar Key / Cerrar Sesión"
                android:textAllCaps="false"
                android:textColor="#B9F6CA"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 1. Selector de Juego (Cambia automáticamente los archivos entre FF Normal y FF MAX) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0C2618"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. SELECCIONA TU VERSIÓN DE FREE FIRE"
                android:textColor="#00E676"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgGameTarget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbFreeFireNormal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Free Fire Normal (com.dts.freefireth)"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbFreeFireMax"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Free Fire MAX (com.dts.freefiremax)"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </RadioGroup>
        </LinearLayout>

        <!-- 2. Información del Paquete de Archivos Activo según la versión elegida -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0C2618"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. ARCHIVOS RGB ACTIVOS PARA LA VERSIÓN ELEGIDA"
                android:textColor="#00E676"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvActiveFilesInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#123824"
                android:padding="12dp"
                android:text="Modo actual: FREE FIRE NORMAL
• ORIFILEINFO_NORMAL (134 KB)
• BYPASS_NORMAL (134 KB)
• RGB_NORMAL / shaders.XITOMODS~FREE~3D (911 KB)"
                android:textColor="#69F0AE"
                android:textSize="13sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cbAutoReplaceInstalledHash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:checked="true"
                android:text="Reemplazar también automáticamente el shaders.&lt;hash&gt; instalado en el juego (con respaldo .bak)"
                android:textColor="#A5D6A7"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 3. Controles de Inyección y Bypass -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0C2618"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. ACCIONES DEL PANEL RGB"
                android:textColor="#00E676"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnStep1Prepare"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="#00C853"
                android:padding="12dp"
                android:text="PASO 1: Preparar ORIFILEINFO + Abrir Juego"
                android:textAllCaps="false"
                android:textColor="#041009"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnStep2ActivateLobby"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#00E676"
                android:padding="12dp"
                android:text="PASO 2 (En Lobby): Activar BYPASS + Inyectar RGB"
                android:textAllCaps="false"
                android:textColor="#041009"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDirectInjectOnly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#1B5E20"
                android:padding="12dp"
                android:text="Inyección Directa RGB (Sin tocar fileinfo)"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRestoreClean"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#EF233C"
                android:padding="12dp"
                android:text="DESACTIVAR TODO: Restaurar Original (.bak + ORIFILEINFO)"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Consola de Registro -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#081C11"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONSOLA DE ESTADO (SHIZUKU SHELL)"
                android:textColor="#00E676"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvConsoleLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:text="[Listo] Selecciona Free Fire Normal o Free Fire MAX; los archivos cambiarán automáticamente."
                android:textColor="#E0E0E0"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
